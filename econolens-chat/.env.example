# Sao chép file này thành .env và điền API key của bạn
PORT=3333
JWT_SECRET=doi-chuoi-bi-mat-nay

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# xAI Grok — https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-3

# Provider "Gemini Web" nay đi qua SERVER AI LOCAL (:4000) thay vì lái Chrome CDP.
# Key có thể để ở đây HOẶC dùng chung từ "data-crawler/.env" (client tự đọc sang).
LOCAL_API_KEY=
# LOCAL_API_URL=http://localhost:4000/v1/chat/completions
# LOCAL_API_MODEL=gemini-cdp
# Đặt =1 nếu muốn tự lái Chrome :9222 khi server local hỏng (dự phòng):
# LOCAL_API_CDP_FALLBACK=0
