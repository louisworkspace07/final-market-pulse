# Sao chép thành .env rồi điền giá trị thật (.env bị .gitignore bỏ qua).
#
# FILE NÀY LÀ CẤU HÌNH DÙNG CHUNG CHO CẢ 4 DỰ ÁN: client Local API của
# Crawl Data (:5000), Bảng giá (:5555), Gateway (:9999) và EconoLens (:3333)
# đều đọc biến môi trường trước, rồi mới tới file này.

# Backend phân tích: local_api (mặc định) | gemini (Chrome CDP) | claude
AI_BACKEND=local_api

# --- Server AI local tự phát triển (kênh AI MẶC ĐỊNH của toàn hệ thống) ---
# API Key lấy từ Dashboard của dự án API share community.
# Có thể lưu nhanh bằng nút "Lưu" cạnh ô API key trên bảng điều khiển :5000.
LOCAL_API_KEY=
# Chỉ đặt khi server chạy khác mặc định:
# LOCAL_API_URL=http://localhost:4000/v1/chat/completions
# LOCAL_API_MODEL=gemini-cdp
# LOCAL_API_TIMEOUT=300
# Số mã phân tích song song qua Local API (P4/pipeline):
# LOCAL_API_MAX_WORKERS=3

# Chỉ cần khi AI_BACKEND=claude
ANTHROPIC_API_KEY=

# API Key của vnstock để tăng giới hạn tải dữ liệu từ FireAnt/SSI
# (lấy tại https://vnstocks.com/login)
VNSTOCK_API_KEY=
