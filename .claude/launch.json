{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "econopulse-gateway",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3.12", "gateway/app.py"],
      "cwd": "market-pulse",
      "port": 9999,
      "autoPort": false,
      "env": { "MP_NO_SPAWN": "1", "PYTHONUTF8": "1" }
    },
    {
      "name": "crawl-data",
